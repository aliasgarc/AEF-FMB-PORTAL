# Neon Postgres connection string (get from Neon dashboard -> Connection Details
# -> use the "pooled connection" string when deploying to Vercel)
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require&channel_binding=require
# Secret used to sign admin login JWTs — set this to a long random string (min 32 characters)
# IMPORTANT: Generate a secure random string for this in production (use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Optional, local dev only
PORT=3000
NODE_ENV=development
